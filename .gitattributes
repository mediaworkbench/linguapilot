# Keep development files out of release archives (`git archive`, bin/build-release.sh).
# Directory rules come in pairs: `/dir` for git archive, `/dir/**` so `git check-attr` matches the files inside.
/.claude            export-ignore
/.claude/**         export-ignore
/.github            export-ignore
/.github/**         export-ignore
/bin                export-ignore
/bin/**             export-ignore
/docs               export-ignore
/docs/**            export-ignore
/tests              export-ignore
/tests/**           export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
/README.md          export-ignore
/composer.lock      export-ignore
/phpcs.xml.dist     export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/phpunit-integration.xml.dist export-ignore
/phpunit-store.xml.dist export-ignore

*.sh text eol=lf
/languages/*.po export-ignore
/languages/*.mo export-ignore
