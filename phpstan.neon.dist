# szepeviktor/phpstan-wordpress is loaded automatically by phpstan/extension-installer.
parameters:
	level: 8
	paths:
		- multilingual-store-abilities.php
		- uninstall.php
		- bin/check-readonly.php
		- src
		- tests
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/wordpress-tests-stubs/wordpress-tests-stubs.php
		- tests/phpstan/wp-cli-stub.php
	excludePaths:
		- tests/Integration/bootstrap.php
