#: src/Abilities/TranslationWorkQueue.php:56
msgid "Translation work queue"
msgstr ""

#: src/Abilities/TranslationWorkQueue.php:63
msgid "Ranks products that are not yet translated (published) into every requested language by their sales in a recent period, so the best sellers get translated first. Sales from all language versions of a product are summed under its original. Revenue is net revenue in the store base currency (meta.currency) from WooCommerce Analytics, with the order statuses Analytics excludes; meta.data_source says whether Analytics or raw order items were used, and meta.analytics_missing_orders how many recent orders Analytics has not imported yet."
msgstr ""

#: src/Abilities/TranslationWorkQueue.php:77
msgid "Sales period in days, counted back from now."
msgstr ""

#: src/Abilities/TranslationWorkQueue.php:108
#: src/Abilities/UntranslatedVariations.php:136
