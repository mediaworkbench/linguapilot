#. Plugin Name of the plugin
#: multilingual-store-abilities.php
msgid "Multilingual Store Abilities for WooCommerce & WPML"
msgstr ""

#. Description of the plugin
#: multilingual-store-abilities.php
msgid "Read-only abilities (WordPress Abilities API) that let AI agents audit translations, cross-language consistency and multi-currency prices in WooCommerce stores running WPML."
msgstr ""

