msgstr ""

#: src/Abilities/TranslationWorkQueue.php:114
msgid "Net revenue in the period (store base currency), all language versions."
msgstr ""

#: src/Abilities/TranslationWorkQueue.php:133
msgid "Revenue of all products with sales that are not fully translated (not only the listed ones)."
msgstr ""

#: src/Abilities/TranslationWorkQueue.php:163
msgid "Orders in the period that WooCommerce Analytics has not imported yet (they are not in the ranking)."
msgstr ""

#: src/Abilities/UntranslatedVariations.php:68
msgid "Untranslated variations"
msgstr ""

#: src/Abilities/UntranslatedVariations.php:75
msgid "Finds translated variable products whose variations or variation attributes are not properly translated, the classic cause of broken variation selectors in translated shops. Issues per product and language: variation_missing, attribute_term_untranslated, local_attribute_missing, local_attribute_options_mismatch and variation_attribute_value_invalid (severity error: shoppers are affected); local_attribute_identical and local_attribute_label_untranslated (severity review: may be intentional, e.g. sizes like S | M | L)."
msgstr ""

